<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
  xmlns:oor="http://openoffice.org/2001/registry"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  oor:name="Addons"
  oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- Top Menu Bar -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.quran.libreoffice.menubar" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Holy Quran</value>
          <value xml:lang="ar">القرآن الكريم</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="M1" oor:op="replace">
            <prop oor:name="Title">
              <value xml:lang="en-US">Insert Quran Verses...</value>
              <value xml:lang="ar">إدراج آيات من القرآن الكريم...</value>
            </prop>
            <prop oor:name="URL">
              <value>vnd.sun.star.script:QuranBasic.QuranModule.InsertQuran?language=Basic&amp;location=application</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="M2" oor:op="replace">
            <prop oor:name="Title">
              <value xml:lang="en-US">About Quran Extension...</value>
              <value xml:lang="ar">حول إضافة القرآن الكريم...</value>
            </prop>
            <prop oor:name="URL">
              <value>vnd.sun.star.script:QuranBasic.QuranModule.ShowAbout?language=Basic&amp;location=application</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
        </node>
      </node>
    </node>

    <!-- Standard Tools -> Add-Ons Menu -->
    <node oor:name="AddonMenu">
      <node oor:name="org.quran.libreoffice.addonmenu" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.sun.star.script:QuranBasic.QuranModule.InsertQuran?language=Basic&amp;location=application</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Insert Quran (Uthmanic Script)...</value>
          <value xml:lang="ar">إدراج القرآن الكريم بالرسم العثماني...</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
      </node>
    </node>

    <!-- Toolbar Button -->
    <node oor:name="OfficeToolBar">
      <node oor:name="org.quran.libreoffice.toolbar" oor:op="replace">
        <node oor:name="t01" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.sun.star.script:QuranBasic.QuranModule.InsertQuran?language=Basic&amp;location=application</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Insert Quran</value>
            <value xml:lang="ar">إدراج القرآن الكريم</value>
          </prop>
        </node>
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Holy Quran</value>
          <value xml:lang="ar">القرآن الكريم</value>
        </prop>
      </node>
    </node>

    <!-- Images -->
    <node oor:name="Images">
      <node oor:name="org.quran.libreoffice.images" oor:op="replace">
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL">
            <value>vnd.sun.star.extension://org.quran.libreoffice.extension/icons/quran_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL">
            <value>vnd.sun.star.extension://org.quran.libreoffice.extension/icons/quran_26.png</value>
          </prop>
        </node>
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.sun.star.script:QuranBasic.QuranModule.InsertQuran?language=Basic&amp;location=application</value>
        </prop>
      </node>
    </node>

  </node>
</oor:component-data>
